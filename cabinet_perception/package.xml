<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cabinet_perception</name>
  <version>0.1.0</version>
  <description>Cabinet (cubby) perception for Pick &amp; Place 5.2: shelf boards, cubbies (level x column), shelf members in 3D and free space, published as a CabinetScene for object_grouping.</description>
  <maintainer email="teamrobontu@gmail.com">Nanyang Technological University Team Robo</maintainer>
  <license>Apache-2.0</license>
  <author>Chen Ting-Ju (Cynthia)</author>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>core_r1_interfaces</depend>
  <depend>object_grouping_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>   <!-- ~/overlay only -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
